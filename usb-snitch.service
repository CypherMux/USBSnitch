[Unit]
Description=USBSnitch Hardware Monitor
After=network.target

[Service]
Type=simple
User=root
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/python3 /usr/local/bin/usb-snitch.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
